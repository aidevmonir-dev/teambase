# Copy to .env and fill in. Never commit the real .env.

# Required in production: a long random string.
SECRET_KEY=
# 1 for local development only.
DEBUG=0
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
# The public address, used in invitation links and Stripe redirects.
SITE_URL=https://app.example.com

# Where the exported frontend lives. Defaults to frontend/out inside the project.
# FRONTEND_DIR=/home/USER/app.example.com

# Stripe (optional). Leave empty for demo billing: plan changes apply without payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# The "Try the demo" button and its limits.
DEMO_ENABLED=1
DEMO_RETENTION_HOURS=24
SIGNUPS_PER_IP_PER_DAY=10
LOGIN_ATTEMPTS_PER_IP_PER_HOUR=20
